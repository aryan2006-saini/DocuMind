# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# groq = real answers, fake = offline extractive answers (demo/tests, no key needed)
LLM_PROVIDER=groq

# fastembed = real local embeddings, hash = tiny offline embedder for tests
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-en-v1.5
USE_RERANKER=true

DATABASE_URL=postgresql://documind:documind@localhost:5433/documind
